# Browser-visible API origin (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000

# Optional frontend error reporting (leave blank until secret exists).
VITE_SENTRY_DSN=

# Force-enable /dev/design-system outside local/staging host heuristics (optional).
# VITE_ENABLE_DESIGN_SYSTEM_PREVIEW=true

# Firebase web config (staging project). Authorized domains must include localhost and Netlify.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local/test stub auth against backend FIREBASE_AUTH_STUB=true (Bearer test:<uid>:<email>).
# Enabled automatically in Vitest (MODE=test). Set true for local UI without Firebase.
# VITE_AUTH_STUB=true

# Optional Mixpanel project token for non-PII activation events.
VITE_MIXPANEL_TOKEN=
